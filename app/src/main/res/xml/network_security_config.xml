<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Cleartext permitted: Ibis only connects to user-configured servers
         (Electrum, mempool instances). No arbitrary web content is loaded.
         Lightning Node cleartext is gated one layer up (explicit per-host
         acknowledgment + fail-closed clients), so this flag alone cannot
         leak LND macaroons / CLN runes. -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
